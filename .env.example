# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# With these set, Forge stores accounts and progress in Firebase instead of the Forge server.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: where your local Ollama listens when running without the Forge server
# VITE_OLLAMA_URL=http://localhost:11434
